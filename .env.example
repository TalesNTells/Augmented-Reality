# Password for /admin  (REQUIRED in production)
ADMIN_PASSWORD=change-me-to-something-long

# Optional: separate secret used to sign the admin login cookie.
# Defaults to ADMIN_PASSWORD. Changing it logs everyone out.
AUTH_SECRET=

# Added automatically when you connect a Vercel Blob store to the project.
# Leave empty for local development (files then go to ./.data).
BLOB_READ_WRITE_TOKEN=
